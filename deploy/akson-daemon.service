[Unit]
Description=Akson daemon — signed task exchange between sovereign agents
Documentation=file:///usr/share/doc/akson/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akson
Group=akson
ExecStart=/usr/local/bin/aksond serve
Restart=on-failure
RestartSec=2

# --- what the daemon needs -------------------------------------------------
# The clean-worker sandbox needs a delegated cgroup v2 subtree (memory, pids).
Delegate=yes
RuntimeDirectory=akson
# 0710 (not 0700): the coordination driver's identity must TRAVERSE this
# directory to reach coord.sock. It cannot list it, and the socket's own
# SO_PEERCRED check — not the mode — is the boundary (ADR-0016).
RuntimeDirectoryMode=0710
Group=akson
# The driver's numeric UID, so the daemon binds coord.sock at all. Unset ⇒
# the socket is never created (ADR-0016's "absent rather than guarded") — the
# correct default: a host with no driver should not expose the surface.
# systemd has no specifier for another user's UID, so the installer
# substitutes it, and deploy/verify.sh reports whether it is set:
#   sudo systemctl edit akson-daemon.service
#   [Service] Environment=AKSON_COORD_UID=<id -u akson-coord>
# Environment=AKSON_COORD_UID=
StateDirectory=akson
StateDirectoryMode=0700
Environment=AKSON_RUNTIME_DIR=/run/akson
Environment=AKSON_DATA_DIR=/var/lib/akson

# --- hardening the sandbox tolerates --------------------------------------
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/akson
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=no
RemoveIPC=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# The daemon itself opens only AF_UNIX (control sockets) and AF_INET/AF_INET6
# (the RECEIVE listener and the broker's egress).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The daemon needs no capabilities: it binds a high port, and the sandbox's
# privilege comes from unprivileged user namespaces, not from the parent.
CapabilityBoundingSet=
AmbientCapabilities=
# Credentials the operator's login holds must not be inheritable (A0.6).
UnsetEnvironment=SSH_AUTH_SOCK SSH_AGENT_PID AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY DIGITALOCEAN_TOKEN ANTHROPIC_API_KEY OPENAI_API_KEY

# --- deliberately NOT set, with reasons -----------------------------------
# PrivateUsers=yes          breaks the sandbox's unprivileged user namespace
# RestrictNamespaces=...    the sandbox creates user/mount/pid/net namespaces
# ProtectKernelTunables=yes blocks the mount propagation the sandbox needs
# SystemCallFilter=...      would have to permit clone/unshare/mount/pivot_root,
#                           i.e. exactly the calls a filter exists to remove —
#                           the inner sandbox is the enforcement boundary here
# ProtectControlGroups=yes  incompatible with Delegate=yes
# IPAddressDeny=/Allow=     the broker's own egress allowlist is the authority;
#                           a coarser second copy here would drift from it

[Install]
WantedBy=multi-user.target
